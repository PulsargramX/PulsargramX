* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.webp binary
*.ttf binary
*.mp3 binary
*.wav binary
*.jar binary

*.tgx-theme text eol=lf
*.dic text eol=lf

gradlew text eol=lf
app/jniLibs/*/*.so filter=lfs diff=lfs merge=lfs -text
*.zip -delta
# Unified diffs preserve the leading space on blank context lines.
patches/tdlib/*.patch whitespace=-blank-at-eol,-blank-at-eof
